<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand palette: cyan / teal -->
    <Color x:Key="BrandPrimaryColor">#FF0891B2</Color>
    <Color x:Key="BrandPrimaryDarkColor">#FF0E7490</Color>
    <Color x:Key="BrandAccentColor">#FF22D3EE</Color>
    <Color x:Key="BrandSurfaceColor">#FFEEF4F7</Color>
    <Color x:Key="BrandCardColor">#FFFFFFFF</Color>
    <Color x:Key="BrandTextColor">#FF0F172A</Color>
    <Color x:Key="BrandSubtleTextColor">#FF64748B</Color>
    <Color x:Key="BrandBorderColor">#FFD9E2EA</Color>
    <Color x:Key="BrandSuccessColor">#FF16A34A</Color>
    <Color x:Key="BrandDangerColor">#FFDC2626</Color>

    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimaryColor}" />
    <SolidColorBrush x:Key="BrandPrimaryDarkBrush" Color="{StaticResource BrandPrimaryDarkColor}" />
    <SolidColorBrush x:Key="BrandAccentBrush" Color="{StaticResource BrandAccentColor}" />
    <SolidColorBrush x:Key="BrandSurfaceBrush" Color="{StaticResource BrandSurfaceColor}" />
    <SolidColorBrush x:Key="BrandCardBrush" Color="{StaticResource BrandCardColor}" />
    <SolidColorBrush x:Key="BrandTextBrush" Color="{StaticResource BrandTextColor}" />
    <SolidColorBrush x:Key="BrandSubtleTextBrush" Color="{StaticResource BrandSubtleTextColor}" />
    <SolidColorBrush x:Key="BrandBorderBrush" Color="{StaticResource BrandBorderColor}" />
    <SolidColorBrush x:Key="BrandSuccessBrush" Color="{StaticResource BrandSuccessColor}" />
    <SolidColorBrush x:Key="BrandDangerBrush" Color="{StaticResource BrandDangerColor}" />

    <!-- Soft surface (search pill, filter chip resting bg, stock-bar track) -->
    <SolidColorBrush x:Key="BrandSoftSurfaceBrush" Color="#FFF1F5F9" />
    <SolidColorBrush x:Key="BrandSoftSurfaceAltBrush" Color="#FFF8FAFC" />
    <SolidColorBrush x:Key="BrandSubtleTextDarkBrush" Color="#FF475569" />

    <!-- Semantic chip palettes (background + foreground pairs) -->
    <SolidColorBrush x:Key="SuccessBgBrush" Color="#FFDCFCE7" />
    <SolidColorBrush x:Key="SuccessFgBrush" Color="#FF166534" />
    <SolidColorBrush x:Key="WarnBgBrush"    Color="#FFFEF3C7" />
    <SolidColorBrush x:Key="WarnFgBrush"    Color="#FF92400E" />
    <SolidColorBrush x:Key="WarnFgDarkBrush" Color="#FFB45309" />
    <SolidColorBrush x:Key="WarnAccentBrush" Color="#FFF59E0B" />
    <SolidColorBrush x:Key="DangerBgBrush"  Color="#FFFEE2E2" />
    <SolidColorBrush x:Key="DangerFgBrush"  Color="#FF991B1B" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#FFFCA5A5" />
    <SolidColorBrush x:Key="InfoBgBrush"    Color="#FFECFEFF" />
    <SolidColorBrush x:Key="InfoFgBrush"    Color="#FF155E75" />
    <SolidColorBrush x:Key="InfoBorderBrush" Color="#FFA5F3FC" />

    <!-- Category swatch palette (used on Inventory rows) -->
    <SolidColorBrush x:Key="SwatchBreakfastBg" Color="#FFFEF3C7" />
    <SolidColorBrush x:Key="SwatchBreakfastFg" Color="#FF92400E" />
    <SolidColorBrush x:Key="SwatchBeveragesBg" Color="#FFDBEAFE" />
    <SolidColorBrush x:Key="SwatchBeveragesFg" Color="#FF1E40AF" />
    <SolidColorBrush x:Key="SwatchMealsBg"     Color="#FFDCFCE7" />
    <SolidColorBrush x:Key="SwatchMealsFg"     Color="#FF166534" />
    <SolidColorBrush x:Key="SwatchSnacksBg"    Color="#FFFCE7F3" />
    <SolidColorBrush x:Key="SwatchSnacksFg"    Color="#FF9D174D" />
    <SolidColorBrush x:Key="SwatchSweetsBg"    Color="#FFEDE9FE" />
    <SolidColorBrush x:Key="SwatchSweetsFg"    Color="#FF5B21B6" />

    <!-- Icon font for in-app glyphs (Segoe MDL2 Assets ships with Windows) -->
    <FontFamily x:Key="BrandIconFontFamily">Segoe MDL2 Assets</FontFamily>

    <LinearGradientBrush x:Key="BrandHeaderBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF0E7490" Offset="0" />
        <GradientStop Color="#FF06B6D4" Offset="1" />
    </LinearGradientBrush>

    <!-- Cart panel header (vertical) — design-system "cartHead" gradient -->
    <LinearGradientBrush x:Key="BrandCartHeaderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF0891B2" Offset="0" />
        <GradientStop Color="#FF0E7490" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrandSidebarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF083344" Offset="0" />
        <GradientStop Color="#FF0E2A37" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrandCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrandBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="12" ShadowDepth="2" Direction="270" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="KpiValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrandTextBrush}" />
    </Style>

    <Style x:Key="KpiLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource BrandSubtleTextBrush}" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrandTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrandTextBrush}" />
    </Style>

    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource BrandSubtleTextBrush}" />
    </Style>

    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="GroupName" Value="MainNav" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="#FFE5E7EB" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandPrimaryBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Margin" Value="10,2" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrandPrimaryBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}"
                                          TextElement.FontSize="{TemplateBinding FontSize}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandPrimaryDarkBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrandTextBrush}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="BorderBrush" Value="{StaticResource BrandBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}"
                                          TextElement.FontSize="{TemplateBinding FontSize}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFF3F4F6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Foreground" Value="{StaticResource BrandDangerBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrandDangerBrush}" />
    </Style>

    <!-- Square icon-only button used inside table action cells -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrandPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrandBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFE0F7FA" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrandPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconDangerButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Foreground" Value="{StaticResource BrandDangerBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FFFEE2E2" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ======== Icon glyph (Segoe MDL2 Assets) ======== -->
    <Style x:Key="IconGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BrandIconFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style x:Key="IconGlyphSmall" TargetType="TextBlock" BasedOn="{StaticResource IconGlyph}">
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="IconGlyphLarge" TargetType="TextBlock" BasedOn="{StaticResource IconGlyph}">
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- ======== KPI card (smaller padding than section cards) ======== -->
    <Style x:Key="KpiCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="14,12,14,14" />
    </Style>

    <!-- 22x22 rounded square that hosts a colored icon glyph in KPI labels -->
    <Style x:Key="KpiIconChip" TargetType="Border">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ======== Filter rail (search pill + chip filters) ======== -->
    <Style x:Key="FilterRailCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrandCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrandBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="12" ShadowDepth="2" Direction="270" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SearchPill" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BrandSoftSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource BrandTextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="White" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrandPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filter chip used in the rail (gray off, dark-cyan on)
         MUI Chip spec: 32px tall, radius = 16 (= height/2), 12px h-padding.
         Vertical padding is 0 — MinHeight gives the chip its height so the
         corner radius produces clean semicircular ends, not an oval. -->
    <Style x:Key="FilterChip" TargetType="ToggleButton">
        <Setter Property="Background" Value="{StaticResource BrandSoftSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource BrandSubtleTextDarkBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="16"
                            MinHeight="{TemplateBinding MinHeight}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFE2E8F0" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandPrimaryDarkBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Category tag (small pill in inventory table cells) -->
    <Style x:Key="CategoryTagPill" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrandSoftSurfaceBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Stock progress bar (light track + colored fill) -->
    <Style x:Key="StockBarTrack" TargetType="Border">
        <Setter Property="Height" Value="5" />
        <Setter Property="Background" Value="{StaticResource BrandSoftSurfaceBrush}" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>

    <!-- 32x32 colored category swatch on inventory rows -->
    <Style x:Key="RowSwatch" TargetType="Border">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Status badge inline in cells (LOW / OUT) — small pill -->
    <Style x:Key="InlineStatusBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>

    <!-- Segment radio (Today / Week / Month / Year ghost-segment) -->
    <Style x:Key="SegmentRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource BrandTextBrush}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFF3F4F6" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandPrimaryBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Day divider band used in lists with date grouping -->
    <Style x:Key="DayDividerBand" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrandSoftSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrandBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="14,10" />
    </Style>

    <!-- Compact 38x38 brand markBox in the sidebar -->
    <Style x:Key="BrandMarkBox" TargetType="Border">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="#1F22D3EE" />
        <Setter Property="BorderBrush" Value="#5922D3EE" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ======== Shared DataGrid cell/element styles ======== -->
    <Style x:Key="DataGridLeftCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="DataGridRightCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="DataGridCenterCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="DataGridLeftText" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="DataGridBoldText" TargetType="TextBlock" BasedOn="{StaticResource DataGridLeftText}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="DataGridRightBoldText" TargetType="TextBlock" BasedOn="{StaticResource DataGridBoldText}">
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style x:Key="DataGridMoneyText" TargetType="TextBlock" BasedOn="{StaticResource DataGridRightBoldText}">
        <Setter Property="Foreground" Value="{StaticResource BrandPrimaryBrush}" />
    </Style>
    <Style x:Key="DataGridMonoText" TargetType="TextBlock" BasedOn="{StaticResource DataGridRightBoldText}">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
    </Style>
    <Style x:Key="DataGridQtyText" TargetType="TextBlock" BasedOn="{StaticResource DataGridLeftText}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="DataGridEditTextBox" TargetType="TextBox">
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="6,2" />
    </Style>

    <!-- Header styles that match cell alignment -->
    <Style x:Key="DataGridLeftHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style x:Key="DataGridCenterHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="DataGridRightHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>

    <!-- ======== Small payment / status pill ======== -->
    <Style x:Key="PaymentChip" TargetType="Border">
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- MUI-style pill switch (CheckBox-based) themed in cyan/teal -->
    <Style x:Key="SwitchToggle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" Width="44" Height="24">
                        <Border x:Name="Track"
                                CornerRadius="12"
                                Background="#FFCBD5E1" />
                        <Border x:Name="Thumb"
                                Width="18" Height="18"
                                CornerRadius="9"
                                Background="White"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="3,0,0,0"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ThumbTransform" X="0" />
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" Opacity="0.25" ShadowDepth="1" Direction="270" Color="#000000" />
                            </Border.Effect>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource BrandPrimaryBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="20"
                                                         Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="0"
                                                         Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="QtyButton" TargetType="Button">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource BrandPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrandPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}"
                                          TextElement.FontSize="{TemplateBinding FontSize}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandPrimaryBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandPrimaryDarkBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MenuTile" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrandCardBrush}" />
        <Setter Property="Foreground" Value="{StaticResource BrandTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrandBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" Opacity="0.07" BlurRadius="10" ShadowDepth="2" Direction="270" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrandPrimaryBrush}" />
                            <Setter TargetName="Bd" Property="Background" Value="#FFE0F7FA" />
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#000000" Opacity="0.13" BlurRadius="14" ShadowDepth="3" Direction="270" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="-1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Category filter chip on Take Order page (MUI pill, 32px tall) -->
    <Style x:Key="CategoryChip" TargetType="Button">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource BrandTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrandBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="16"
                            MinHeight="{TemplateBinding MinHeight}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pill-style payment radio (Cash / UPI / Card) — true pill, 36px tall -->
    <Style x:Key="PaymentPill" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource BrandTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd"
                            Background="White"
                            BorderBrush="{StaticResource BrandBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="18"
                            MinHeight="{TemplateBinding MinHeight}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse x:Name="OuterDot" Stroke="#FF94A3B8" StrokeThickness="1.5" Fill="Transparent" />
                                <Ellipse x:Name="InnerDot" Margin="3" Fill="Transparent" />
                            </Grid>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.FontSize="{TemplateBinding FontSize}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFF8FAFC" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFECFEFF" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrandPrimaryBrush}" />
                            <Setter TargetName="OuterDot" Property="Stroke" Value="{StaticResource BrandPrimaryBrush}" />
                            <Setter TargetName="InnerDot" Property="Fill" Value="{StaticResource BrandPrimaryBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource BrandPrimaryDarkBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         Implicit styles — applied app-wide to fix contrast/visibility
         ============================================================ -->

    <!-- Touch-friendly scrolling: every ScrollViewer in the app accepts
         finger panning by default so the user can swipe up/down without
         grabbing the scrollbar thumb (POS touchscreen ergonomics). -->
    <Style TargetType="ScrollViewer">
        <Setter Property="PanningMode" Value="VerticalFirst" />
        <Setter Property="PanningDeceleration" Value="0.001" />
        <Setter Property="PanningRatio" Value="1" />
    </Style>

    <!-- ============================================================
         Slim pill scroll bars — named style, applied per ScrollViewer.
         (We don't override implicit ScrollBar globally because that
         interferes with ComboBox / DataGrid chrome at load time.)

         Usage: <ScrollViewer Style="{StaticResource SlimScroll}"> ...
         ============================================================ -->
    <Style x:Key="SlimScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Border x:Name="ThumbVisual"
                                Background="#FFB0BAC4"
                                CornerRadius="4"
                                Margin="3"
                                Opacity="0.6" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbVisual" Property="Background" Value="{StaticResource BrandPrimaryBrush}" />
                            <Setter TargetName="ThumbVisual" Property="Opacity" Value="0.95" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbVisual" Property="Background" Value="{StaticResource BrandPrimaryDarkBrush}" />
                            <Setter TargetName="ThumbVisual" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="11" />
        <Setter Property="MinWidth" Value="11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SlimScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Opacity="0"
                                              Focusable="False"
                                              IsTabStop="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Opacity="0"
                                              Focusable="False"
                                              IsTabStop="False" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="Height" Value="11" />
                            <Setter Property="MinHeight" Value="11" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Drop-in inline resource that retargets the ScrollBars *inside* a
         single ScrollViewer to the slim style. Use as:
           <ScrollViewer ...>
               <ScrollViewer.Resources>
                   <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
               </ScrollViewer.Resources>
               ...
           </ScrollViewer>
         Scoped this way it cannot leak into ComboBox / DataGrid templates. -->



    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource BrandTextBrush}" />
        <Setter Property="RowBackground" Value="White" />
        <Setter Property="AlternatingRowBackground" Value="#FFF7F8FA" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BrandBorderBrush}" />
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource BrandBorderBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrandBorderBrush}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="ColumnHeaderHeight" Value="44" />
        <Setter Property="RowHeight" Value="48" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#FFF8FAFC" />
        <Setter Property="Foreground" Value="#FF475569" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="BorderBrush" Value="{StaticResource BrandBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SeparatorVisibility" Value="Collapsed" />
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{StaticResource BrandTextBrush}" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#FFE0F7FA" />
                <Setter Property="Foreground" Value="{StaticResource BrandTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Foreground" Value="{StaticResource BrandTextBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FFE0F7FA" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
