<Window x:Class="RestaurantOrder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:local="clr-namespace:RestaurantOrder"
        xmlns:controls="clr-namespace:RestaurantOrder.Controls"
        mc:Ignorable="d"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Arya Vysya SSV — Restaurant Manager"
        Height="800" Width="1280"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource BrandSurfaceBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource BrandSidebarBrush}">
            <DockPanel LastChildFill="True">

                <!-- Brand header (compact markBox lockup) -->
                <Border DockPanel.Dock="Top" Padding="18,22,18,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource BrandMarkBox}" VerticalAlignment="Center">
                            <controls:LogoMark Width="26" Height="26" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Arya Vysya SSV"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="White" />
                            <TextBlock Text="RESTAURANT MANAGER"
                                       FontSize="10"
                                       Foreground="#FF9CA3AF" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Footer -->
                <Border DockPanel.Dock="Bottom" Padding="22,14,22,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource BrandAccentBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="Local · Offline"
                                       Foreground="#FF9CA3AF" FontSize="11"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="v1.0"
                                   Foreground="#FF6B7280" FontSize="10"
                                   FontFamily="Cascadia Mono, Consolas"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Nav -->
                <StackPanel>
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButton}" IsChecked="True"
                                 Click="Nav_Click" Tag="Dashboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="{StaticResource BrandIconFontFamily}"
                                       FontSize="15" Margin="0,0,12,0" Width="18" TextAlignment="Center" />
                            <TextBlock Text="Dashboard" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavOrder" Style="{StaticResource NavButton}"
                                 Click="Nav_Click" Tag="Order">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="{StaticResource BrandIconFontFamily}"
                                       FontSize="15" Margin="0,0,12,0" Width="18" TextAlignment="Center" />
                            <TextBlock Text="Take Order" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavInventory" Style="{StaticResource NavButton}"
                                 Click="Nav_Click" Tag="Inventory">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="{StaticResource BrandIconFontFamily}"
                                       FontSize="15" Margin="0,0,12,0" Width="18" TextAlignment="Center" />
                            <TextBlock Text="Inventory" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavHistory" Style="{StaticResource NavButton}"
                                 Click="Nav_Click" Tag="History">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="{StaticResource BrandIconFontFamily}"
                                       FontSize="15" Margin="0,0,12,0" Width="18" TextAlignment="Center" />
                            <TextBlock Text="Order History" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}"
                                 Click="Nav_Click" Tag="Settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="{StaticResource BrandIconFontFamily}"
                                       FontSize="15" Margin="0,0,12,0" Width="18" TextAlignment="Center" />
                            <TextBlock Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content host -->
        <ContentControl x:Name="ContentHost" Grid.Column="1" Margin="0" />
    </Grid>
</Window>
