<Window x:Class="RestaurantOrder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:local="clr-namespace:RestaurantOrder"
        mc:Ignorable="d"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Araya Vysya SSV — Restaurant Manager"
        Height="800" Width="1280"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource BrandSurfaceBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource BrandSidebarBrush}">
            <DockPanel LastChildFill="True">

                <!-- Brand header -->
                <Border DockPanel.Dock="Top" Padding="22,28,22,18">
                    <StackPanel>
                        <TextBlock Text="🍽" FontSize="30" Foreground="{StaticResource BrandAccentBrush}" />
                        <TextBlock Text="Araya Vysya SSV"
                                   FontSize="20" FontWeight="SemiBold"
                                   Foreground="White" Margin="0,4,0,0" />
                        <TextBlock Text="Restaurant Manager"
                                   FontSize="11"
                                   Foreground="#FF9CA3AF" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- Footer -->
                <Border DockPanel.Dock="Bottom" Padding="14,12,14,18">
                    <StackPanel>
                        <Button Content="⚙  Settings"
                                Click="Settings_Click"
                                HorizontalContentAlignment="Left"
                                Padding="14,10"
                                Margin="0,0,0,12"
                                Background="Transparent"
                                Foreground="#FFE5E7EB"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"
                                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock Text="Local · Offline"
                                   Foreground="#FF9CA3AF" FontSize="11" Margin="8,0,0,0" />
                        <TextBlock Text="v1.0"
                                   Foreground="#FF6B7280" FontSize="10" Margin="8,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- Nav -->
                <StackPanel>
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButton}" IsChecked="True"
                                 Click="Nav_Click" Tag="Dashboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="16" Margin="0,0,12,0" />
                            <TextBlock Text="Dashboard" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavOrder" Style="{StaticResource NavButton}"
                                 Click="Nav_Click" Tag="Order">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛒" FontSize="16" Margin="0,0,12,0" />
                            <TextBlock Text="Take Order" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavInventory" Style="{StaticResource NavButton}"
                                 Click="Nav_Click" Tag="Inventory">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="16" Margin="0,0,12,0" />
                            <TextBlock Text="Inventory" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavHistory" Style="{StaticResource NavButton}"
                                 Click="Nav_Click" Tag="History">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📜" FontSize="16" Margin="0,0,12,0" />
                            <TextBlock Text="Order History" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content host -->
        <ContentControl x:Name="ContentHost" Grid.Column="1" Margin="0" />
    </Grid>
</Window>
