<UserControl x:Class="RestaurantOrder.Views.OrderHistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:c="clr-namespace:RestaurantOrder.Controls"
             xmlns:local="clr-namespace:RestaurantOrder.Views"
             mc:Ignorable="d"
             Background="{StaticResource BrandSurfaceBrush}">

    <UserControl.Resources>
        <!-- Heterogeneous list templates -->
        <DataTemplate DataType="{x:Type local:DayDividerVm}">
            <Border Style="{StaticResource DayDividerBand}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding LabelText}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource BrandSubtleTextDarkBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding TotalText}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource BrandTextBrush}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:OrderRowVm}">
            <Border Background="{Binding RowBackground}"
                    BorderBrush="#FFF1F5F9"
                    BorderThickness="0,0,0,1"
                    Cursor="Hand"
                    Opacity="{Binding RowItemOpacity}"
                    Padding="{Binding RowPadding}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding SelectCommand}" />
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding IdText}"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource BrandSubtleTextDarkBrush}"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CustomerName}"
                                       FontWeight="SemiBold" FontSize="14"
                                       Foreground="{StaticResource BrandTextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <Border Style="{StaticResource PaymentChip}"
                                    Background="{Binding PayBg}"
                                    Margin="8,0,0,0">
                                <TextBlock Text="{Binding PaymentMethodUpper}"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="{Binding PayFg}" />
                            </Border>
                            <Border Style="{StaticResource PaymentChip}"
                                    Background="{StaticResource WarnBgBrush}"
                                    Margin="8,0,0,0"
                                    Visibility="{Binding ParcelBadgeVisibility}">
                                <TextBlock Text="PARCEL"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource WarnFgBrush}" />
                            </Border>
                            <Border Style="{StaticResource PaymentChip}"
                                    Background="{StaticResource DangerBgBrush}"
                                    Margin="8,0,0,0"
                                    Visibility="{Binding VoidedBadgeVisibility}">
                                <TextBlock Text="VOIDED"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource DangerFgBrush}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding TimeText}" FontSize="11"
                                       Foreground="{StaticResource BrandSubtleTextBrush}" />
                            <TextBlock Text="·" FontSize="11"
                                       Foreground="{StaticResource BrandSubtleTextBrush}"
                                       Margin="6,0" />
                            <TextBlock Text="{Binding ItemsText}" FontSize="11"
                                       Foreground="{StaticResource BrandSubtleTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding TotalText}"
                                   FontWeight="SemiBold" FontSize="14"
                                   Foreground="{StaticResource BrandTextBrush}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding PiecesText}" FontSize="11"
                                   Foreground="{StaticResource BrandSubtleTextBrush}"
                                   HorizontalAlignment="Right" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page head -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Order History" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Past orders · click any row to see receipt details · reprint anytime"
                           Style="{StaticResource PageSubtitle}" Margin="0,4,0,0" />
            </StackPanel>
            <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Border Background="White" BorderBrush="{StaticResource BrandBorderBrush}" BorderThickness="1"
                        CornerRadius="20" Padding="10,2" Margin="0,0,8,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <DatePicker x:Name="FromDate" BorderThickness="0" Background="Transparent"
                                    Width="118" SelectedDateChanged="DateRange_Changed" />
                        <TextBox x:Name="FromTime" Width="62" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center" Padding="0" FontSize="13"
                                 ui:ControlHelper.PlaceholderText="00:00"
                                 TextChanged="TimeFilter_Changed" />
                        <TextBlock Text="→" Margin="6,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource BrandSubtleTextBrush}" />
                        <DatePicker x:Name="ToDate" BorderThickness="0" Background="Transparent"
                                    Width="118" SelectedDateChanged="DateRange_Changed" />
                        <TextBox x:Name="ToTime" Width="62" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center" Padding="0" FontSize="13"
                                 ui:ControlHelper.PlaceholderText="23:59"
                                 TextChanged="TimeFilter_Changed" />
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="{StaticResource BrandBorderBrush}" BorderThickness="1"
                        CornerRadius="20" Padding="2" Margin="0,0,8,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RangeToday" GroupName="OhRange" Style="{StaticResource SegmentRadio}"
                                     Padding="14,6" Click="Today_Click">Today</RadioButton>
                        <RadioButton x:Name="RangeWeek"  GroupName="OhRange" Style="{StaticResource SegmentRadio}"
                                     Padding="14,6" IsChecked="True" Click="Week_Click">Week</RadioButton>
                        <RadioButton x:Name="RangeMonth" GroupName="OhRange" Style="{StaticResource SegmentRadio}"
                                     Padding="14,6" Click="Month_Click">Month</RadioButton>
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource GhostButton}" Padding="14,6" Click="ExportCsv_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconGlyphSmall}" Text="" Margin="0,0,6,0"
                                   Foreground="{StaticResource BrandSubtleTextBrush}" />
                        <TextBlock Text="Export CSV" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Grid>

        <!-- KPI strip + sparkline -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="ORDERS" Style="{StaticResource KpiLabel}" FontWeight="SemiBold" />
                    <TextBlock x:Name="KpiOrdersValue" Style="{StaticResource KpiValue}"
                               FontSize="22" Margin="0,6,0,0" />
                    <TextBlock x:Name="KpiOrdersSub" FontSize="11"
                               Foreground="{StaticResource BrandSubtleTextBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="REVENUE" Style="{StaticResource KpiLabel}" FontWeight="SemiBold" />
                    <TextBlock x:Name="KpiRevenueValue" Style="{StaticResource KpiValue}"
                               FontSize="22" Margin="0,6,0,0" />
                    <TextBlock x:Name="KpiRevenueSub" FontSize="11"
                               Foreground="{StaticResource BrandSubtleTextBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="AVG TICKET" Style="{StaticResource KpiLabel}" FontWeight="SemiBold" />
                    <TextBlock x:Name="KpiAvgValue" Style="{StaticResource KpiValue}"
                               FontSize="22" Margin="0,6,0,0" />
                    <TextBlock Text="per order" FontSize="11"
                               Foreground="{StaticResource BrandSubtleTextBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="REPRINTS" Style="{StaticResource KpiLabel}" FontWeight="SemiBold" />
                    <TextBlock x:Name="KpiReprintsValue" Style="{StaticResource KpiValue}"
                               FontSize="22" Margin="0,6,0,0" Text="0" />
                    <TextBlock x:Name="KpiReprintsSub" Text="0% of orders" FontSize="11"
                               Foreground="{StaticResource BrandSubtleTextBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="8" Style="{StaticResource KpiCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ORDERS / DAY" Style="{StaticResource KpiLabel}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" x:Name="SparkPeak" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrandTextBrush}" />
                    </Grid>
                    <c:LineChart x:Name="Spark" Grid.Row="1" Margin="0,4,0,0" />
                </Grid>
            </Border>
        </Grid>

        <!-- Body: list + detail -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*" MinWidth="380" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- List card -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource BrandSoftSurfaceAltBrush}"
                            BorderBrush="{StaticResource BrandBorderBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="10,10,0,0"
                            Padding="10,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="White" BorderBrush="{StaticResource BrandBorderBrush}"
                                        BorderThickness="1" CornerRadius="18" Padding="14,0"
                                        MinHeight="36" MinWidth="220">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource IconGlyph}" Text=""
                                                   FontSize="13"
                                                   Foreground="{StaticResource BrandSubtleTextBrush}"
                                                   Margin="2,0,8,0" />
                                        <TextBox Grid.Column="1" x:Name="SearchBox"
                                                 Background="Transparent" BorderThickness="0"
                                                 ui:ControlHelper.PlaceholderText="Search by order # or customer…"
                                                 FontSize="14" VerticalContentAlignment="Center"
                                                 TextChanged="SearchBox_TextChanged" />
                                    </Grid>
                                </Border>
                                <ToggleButton x:Name="WalkInChip" Style="{StaticResource FilterChip}"
                                              Click="ChannelChip_Click" Margin="10,0,0,0" Content="Walk-in" />
                                <ToggleButton x:Name="ParcelChip" Style="{StaticResource FilterChip}"
                                              Click="ChannelChip_Click" Content="Parcel" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="CountText" VerticalAlignment="Center"
                                       Margin="14,0,4,0"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrandSubtleTextDarkBrush}" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
                        </ScrollViewer.Resources>
                        <ItemsControl x:Name="OrdersList" />
                    </ScrollViewer>

                    <TextBlock Grid.Row="1" x:Name="EmptyState"
                               Text="No orders match the current filters."
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource BrandSubtleTextBrush}"
                               Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- Detail card -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Detail head -->
                    <Border Grid.Row="0" Padding="18,16"
                            BorderBrush="{StaticResource BrandBorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="DetailTitle" Text="Order details"
                                           FontSize="17" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrandTextBrush}"
                                           VerticalAlignment="Center" />
                                <Border x:Name="StatusBadgeClosed" Background="{StaticResource SuccessBgBrush}"
                                        CornerRadius="12" MinHeight="24" Padding="10,0" Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessFgBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Text="CLOSED" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource SuccessFgBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="StatusBadgeVoided" Background="{StaticResource DangerBgBrush}"
                                        CornerRadius="12" MinHeight="24" Padding="10,0" Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource DangerFgBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Text="VOIDED" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource DangerFgBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <WrapPanel x:Name="DetailMetaPanel" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Detail items -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,8">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
                        </ScrollViewer.Resources>
                        <StackPanel x:Name="DetailItems" />
                    </ScrollViewer>

                    <!-- Detail totals -->
                    <Border Grid.Row="2" Padding="18,14"
                            Background="#FFFAFCFD"
                            BorderBrush="{StaticResource BrandBorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel x:Name="DetailTotalsPanel" />
                    </Border>

                    <!-- Action bar -->
                    <Border Grid.Row="3" Padding="14,12"
                            BorderBrush="{StaticResource BrandBorderBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="VoidButton" Grid.Column="0"
                                    Style="{StaticResource DangerButton}"
                                    IsEnabled="False"
                                    Click="VoidOrder_Click">
                                <TextBlock x:Name="VoidButtonText" Text="Void order" />
                            </Button>
                            <Button x:Name="ReprintButton" Grid.Column="2"
                                    Style="{StaticResource PrimaryButton}"
                                    IsEnabled="False"
                                    Click="Reprint_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconGlyphSmall}" Text=""
                                               Foreground="White" Margin="0,0,6,0" />
                                    <TextBlock Text="Reprint receipt" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
