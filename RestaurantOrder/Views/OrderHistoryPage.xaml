<UserControl x:Class="RestaurantOrder.Views.OrderHistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             mc:Ignorable="d"
             Background="{StaticResource BrandSurfaceBrush}">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Order History" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Searchable list of past orders" Style="{StaticResource PageSubtitle}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <DatePicker x:Name="FromDate" Margin="0,0,8,0" SelectedDateChanged="DateRange_Changed" />
                <TextBlock Text="–" VerticalAlignment="Center" Margin="0,0,8,0" />
                <DatePicker x:Name="ToDate" Margin="0,0,8,0" SelectedDateChanged="DateRange_Changed" />
                <Button Content="Today" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Today_Click" />
                <Button Content="This week" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Week_Click" />
                <Button Content="This month" Style="{StaticResource GhostButton}" Click="Month_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox"
                         ui:ControlHelper.PlaceholderText="Search by order # or customer name..."
                         FontSize="13"
                         TextChanged="SearchBox_TextChanged" />
                <TextBlock Grid.Column="1" x:Name="CountText" VerticalAlignment="Center"
                           Margin="16,0,16,0" Foreground="{StaticResource BrandSubtleTextBrush}" />
                <TextBlock Grid.Column="2" x:Name="TotalText" VerticalAlignment="Center"
                           FontWeight="SemiBold" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="320" MaxWidth="440" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <DataGrid x:Name="OrdersGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          RowHeight="36"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          Background="Transparent"
                          RowBackground="White"
                          AlternatingRowBackground="#FFF9FAFB"
                          SelectionChanged="OrdersGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Order #" Binding="{Binding IdText}" Width="90" />
                        <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="170" />
                        <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*" />
                        <DataGridTextColumn Header="Pay" Binding="{Binding PaymentMethod}" Width="80" />
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalText}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock x:Name="DetailTitle" Text="Order details" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                        <TextBlock x:Name="DetailSub" Foreground="{StaticResource BrandSubtleTextBrush}" FontSize="12" Margin="0,0,0,12" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DetailItems" />
                    </ScrollViewer>
                    <Border Grid.Row="2" Margin="0,12,0,0" Padding="0,12,0,0"
                            BorderBrush="{StaticResource BrandBorderBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ReprintButton" Content="Reprint"
                                        Style="{StaticResource GhostButton}"
                                        IsEnabled="False"
                                        Click="Reprint_Click" />
                                <TextBlock x:Name="ReprintFeedback"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource BrandSuccessBrush}"
                                           Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="DetailTotalText"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource BrandPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
