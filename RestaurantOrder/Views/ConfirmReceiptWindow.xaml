<Window x:Class="RestaurantOrder.Views.ConfirmReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        mc:Ignorable="d"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Order Placed"
        Height="640" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BrandSurfaceBrush}">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BrandSuccessBrush}" Padding="22,18">
            <StackPanel>
                <TextBlock Text="✓ Order placed successfully"
                           Foreground="White" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="OrderInfoText" Foreground="#FFE0F2E0" FontSize="12" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="22" Background="White"
                BorderBrush="{StaticResource BrandBorderBrush}" BorderThickness="1"
                CornerRadius="8">
            <FlowDocumentScrollViewer x:Name="Preview"
                                      Padding="6"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" />
        </Border>

        <Border Grid.Row="2" Padding="22,12,22,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="Close"
                        Style="{StaticResource GhostButton}"
                        Click="Close_Click" />
                <Button Grid.Column="3" Content="Print Receipt"
                        Style="{StaticResource PrimaryButton}"
                        Click="Print_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
