<UserControl x:Class="RestaurantOrder.Controls.LogoMark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <!--
        Logo mark — cyan disc with concentric outer ring + serif A monogram.
        Mirrors the inline <svg> used across every v2 mock sidebar.
        viewBox 0 0 64 64.
    -->
    <Viewbox Stretch="Uniform">
        <Grid Width="64" Height="64">
            <!-- Outer ring (50% opacity) -->
            <Ellipse Width="56" Height="56"
                     Stroke="#22D3EE" StrokeThickness="1.5"
                     Opacity="0.5"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />

            <!-- Cyan filled disc -->
            <Ellipse Width="44" Height="44"
                     Fill="#0891B2"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />

            <!-- A monogram -->
            <TextBlock Text="A"
                       FontFamily="Georgia, Cambria, serif"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,-2,0,0" />
        </Grid>
    </Viewbox>
</UserControl>
